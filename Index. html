<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Barber X</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      line-height: 1.6;
    }

    header {
      padding: 20px;
      text-align: center;
      background: #000;
    }

    header h1 {
      color: #d4af37;
    }

    .hero {
      padding: 100px 20px;
      text-align: center;
      background: #222;
    }

    .hero h2 {
      font-size: 42px;
      margin-bottom: 20px;
    }

    .hero p {
      color: #ccc;
      margin-bottom: 30px;
    }

    .button {
      display: inline-block;
      padding: 14px 24px;
      background: #d4af37;
      color: #111;
      text-decoration: none;
      font-weight: bold;
      border-radius: 6px;
    }

    .services {
      padding: 60px 20px;
      max-width: 900px;
      margin: auto;
    }

    .services h2 {
      text-align: center;
      margin-bottom: 30px;
    }

    .cards {
      display: grid;
      gap: 20px;
    }

    .card {
      padding: 25px;
      background: #1d1d1d;
      border-radius: 10px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .price {
      color: #d4af37;
      font-weight: bold;
      margin-top: 10px;
    }

    .contact {
      padding: 60px 20px;
      text-align: center;
      background: #d4af37;
      color: #111;
    }

    footer {
      padding: 25px;
      text-align: center;
      color: #888;
    }
  </style>
</head>

<body>

  <header>
    <h1>BARBER X</h1>
    <p>Premium Barbershop</p>
  </header>

  <section class="hero">
    <h2>Potongan Rapi.<br>Penampilan Maksimal.</h2>

    <p>
      Barbershop modern untuk pria yang ingin tampil
      lebih rapi dan percaya diri.
    </p>

    <a class="button" href="https://wa.me/6281234567890">
      Booking via WhatsApp
    </a>
  </section>

  <section class="services">
    <h2>Layanan Kami</h2>

    <div class="cards">

      <div class="card">
        <h3>Classic Cut</h3>
        <p>Potongan klasik yang rapi dan profesional.</p>
        <div class="price">Rp50.000</div>
      </div>

      <div class="card">
        <h3>Premium Cut</h3>
        <p>Haircut dan styling untuk tampilan maksimal.</p>
        <div class="price">Rp75.000</div>
      </div>

      <div class="card">
        <h3>Haircut + Beard</h3>
        <p>Potong rambut sekaligus merapikan beard.</p>
        <div class="price">Rp100.000</div>
      </div>

    </div>
  </section>

  <section class="contact">
    <h2>Siap tampil lebih rapi?</h2>

    <p>Booking sekarang melalui WhatsApp.</p>

    <br>

    <a class="button" href="https://wa.me/6281234567890">
      Booking Sekarang
    </a>
  </section>

  <footer>
    © 2026 Barber X
  </footer>

</body>
</html>
